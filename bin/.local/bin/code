#!/usr/bin/env bash
# code — launch VS Code from the CLI on macOS.
# Prefer the app bundle's bundled `code` binary; fall back to `open -a`.
set -euo pipefail

cli="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"

if [[ -x "$cli" ]]; then
  exec "$cli" "$@"
fi

# If VS Code isn't installed, `open` exits 1 with "Unable to find
# application named 'Visual Studio Code'" on stderr.
exec open -a "Visual Studio Code" "$@"