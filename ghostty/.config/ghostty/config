# ~/.config/ghostty/config — Ghostty terminal. Syntax is `key = value`.

# Font.
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# Built-in theme (Ghostty 1.2+; was catppuccin-mocha).
theme = Catppuccin Mocha

# Cursor.
cursor-style = block
cursor-style-blink = true

# Window padding.
window-padding-x = 8
window-padding-y = 8
